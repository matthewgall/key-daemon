interval: 5m

# Random jitter added to each interval. Spreads out syncs on a fleet of nodes
# that start at the same time. Must be less than interval.
jitter: 30s
markers:
  begin: "# BEGIN key-daemon"
  end: "# END key-daemon"
backups:
  max_count: 10
  max_age: 7d

# Validate authorized_keys with sshd -t before installing them.
# Set to false if your system uses a different SSH server (e.g. dropbear).
validate: true

# Restrict accepted SSH key algorithms. Leave empty to accept all supported
# types (ssh-rsa, ssh-ed25519, ecdsa-sha2-*).
allowed_key_types: []

# Check GitHub Releases periodically and log when a newer version is
# available. Disabled by default.
check_for_updates: false
update_check_interval: 24h

# Optional Prometheus-style metrics endpoint. Binds to localhost only by
# default when enabled.
metrics:
  enabled: false
  address: 127.0.0.1:9123
  path: /metrics

# Optional remote configuration source. The daemon will periodically fetch this
# URL and overwrite the local config file. HTTPS only. Leave empty to disable.
remote_config:
  url: ""
  # token: "${KEY_DAEMON_REMOTE_TOKEN}"
  interval: 5m

# Optional status file written after each sync. If omitted, the daemon uses
# /var/lib/key-daemon/status.json when running as root and
# ~/.cache/key-daemon/status.json otherwise.
# status_file: /var/lib/key-daemon/status.json

# Discover per-user configs in ~/.config/key-daemon/config.yaml.
discover_user_configs: false

# Source types permitted in per-user configs.
allowed_user_sources:
  - github
  - gitlab
  - codeberg
  - sourcehut
  - launchpad
  - sshid

users:
  - name: root
    sources:
      # Replace these with your own sources.
      - url:https://example.com/keys
      - github:yourusername
      - gitlab:yourusername
      - codeberg:yourusername
      - sourcehut:yourusername
      - launchpad:yourusername
      - sshid:yourusername
