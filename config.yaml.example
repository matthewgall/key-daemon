interval: 5m

# Random jitter added to each interval. Spreads out syncs on a fleet of nodes
# that start at the same time. Must be less than interval.
jitter: 30s
markers:
  begin: "# BEGIN key-daemon"
  end: "# END key-daemon"
backups:
  max_count: 10
  max_age: 7d

# Validate authorized_keys with sshd -t before installing them.
# Set to false if your system uses a different SSH server (e.g. dropbear).
validate: true

# Restrict accepted SSH key algorithms. Leave empty to accept all supported
# types (ssh-rsa, ssh-ed25519, ecdsa-sha2-*).
allowed_key_types: []

# Check GitHub Releases periodically and log when a newer version is
# available. Disabled by default.
check_for_updates: false
update_check_interval: 24h

# Optional Prometheus-style metrics endpoint. Binds to localhost only by
# default when enabled.
metrics:
  enabled: false
  address: 127.0.0.1:9123
  path: /metrics

# Optional remote configuration source. The daemon will periodically fetch this
# URL and overwrite the local config file. HTTPS only. Leave empty to disable.
remote_config:
  url: ""
  # token: "${KEY_DAEMON_REMOTE_TOKEN}"
  interval: 5m

  # Optional SSH signature verification. If public_key is set, the daemon also
  # fetches a detached SSHSIG signature and verifies it before installing the
  # remote config. The public_key accepts the same authorized_keys format used
  # for SSH (e.g. "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5..."). Use
  # `key-daemon sign` to produce the signature file.
  # signature_url defaults to "<url>.sig" when omitted.
  # signature_url: "https://example.com/config.yaml.sig"
  # public_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDIhz2GKHuG2bJ55x2wv5F_qDFLZxFKL3ZGe1kqx93Gf"

# Optional status file written after each sync. If omitted, the daemon uses
# /var/lib/key-daemon/status.json when running as root and
# ~/.cache/key-daemon/status.json otherwise.
# status_file: /var/lib/key-daemon/status.json

# Discover per-user configs in ~/.config/key-daemon/config.yaml.
discover_user_configs: false

# Source types permitted in per-user configs.
allowed_user_sources:
  - github
  - gitlab
  - codeberg
  - sourcehut
  - launchpad
  - sshid

# Optional targeting rules per user. A user entry is only applied when all
# non-empty conditions match the current host. Conditions support shell-style
# glob patterns for hostname and os, and CIDR notation for ip and public_ip.
# If "when" is omitted, the user applies to every host.
#
# Available conditions:
#   hostname  - value of `hostname` (glob, case-insensitive)
#   os        - ID from /etc/os-release (glob, case-insensitive)
#   ip        - local address must fall inside the given CIDR
#   public_ip - public address must fall inside the given CIDR
#
# To use public_ip targeting, set an HTTPS endpoint that returns the host's
# public IP, either as plain text or as a JSON object with an "ip" field.
# The default is empty (disabled).
#
# external_ip_url: https://ipinfo.io/ip
#
# Example:
# users:
#   - name: root
#     sources:
#       - github:common
#   - name: ubuntu-root
#     sources:
#       - github:ubuntu-admins
#     when:
#       os: ubuntu
#       hostname: "web-*"
#       ip: 10.0.0.0/8
#   - name: public-root
#     sources:
#       - github:public-admins
#     when:
#       public_ip: 203.0.113.0/24

users:
  - name: root
    sources:
      # Replace these with your own sources.
      - url:https://example.com/keys
      - github:yourusername
      - gitlab:yourusername
      - codeberg:yourusername
      - sourcehut:yourusername
      - launchpad:yourusername
      - sshid:yourusername
