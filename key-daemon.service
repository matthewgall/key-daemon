[Unit]
Description=key-daemon SSH authorized_keys synchronizer
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/key-daemon run --config /etc/key-daemon/config.yaml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Sandboxing. The daemon needs broad filesystem access to write arbitrary
# users' authorized_keys files, so full filesystem restrictions are not
# applicable, but the following reduce the attack surface.
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
